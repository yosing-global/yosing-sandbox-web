    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "^10.6.6",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
